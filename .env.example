# myaniform 환경변수 — 모든 시크릿/플랫폼 설정의 단일 source.
#
# 사용:
#   1) cp .env.example .env
#   2) 아래 값들 본인 토큰 / 경로로 채움
#   3) bash setup.sh / bash run.sh 가 알아서 source 함 (Windows: setup.ps1 / run.ps1)
#
# 백엔드 (FastAPI / uvicorn) 도 run.sh 가 .env 를 export 한 셸에서 띄우므로
# `os.getenv("KEY")` 로 그대로 읽힘 — python-dotenv 의존 없음.
#
# .env 는 .gitignore 에 등록되어 절대 commit 되지 않음.

# ── 모델 다운로드 토큰 ────────────────────────────────────────────────
# HuggingFace 액세스 토큰 (gated repo: Qwen3-TTS, Wan-AI 등에 필요)
# 발급: https://huggingface.co/settings/tokens
HF_TOKEN=

# Civitai 액세스 토큰 (체크포인트/LoRA 다운로드)
# 발급: https://civitai.com/user/account → API Keys
CIVITAI_TOKEN=

# ── ComfyUI 연결 ─────────────────────────────────────────────────────
# 백엔드가 ComfyUI 와 통신하는 URL. 디폴트는 같은 머신의 8188.
# 다른 머신의 GPU 를 원격으로 쓰고 싶으면 여기 변경:
#   COMFYUI_URL=http://gpu-host.local:8188
# 미설정시: http://127.0.0.1:8188
#COMFYUI_URL=http://127.0.0.1:8188

# ── 다운로드 동작 ────────────────────────────────────────────────────
# 1=설정 시 setup.sh 가 download_models.sh 단계를 스킵 (모델 이미 있음 / 수동 관리)
#MYANIFORM_SKIP_MODEL_DOWNLOAD=0

# 다른 ComfyUI 설치본 (StabilityMatrix, A1111, Forge 등) 의 LoRA 디렉토리를
# 심볼릭링크로 재사용하고 싶을 때만 설정. 일반 사용자는 무시 (기본: 비활성).
# 디렉토리 구조: $MYANIFORM_LORA_FALLBACK/{detailer,wan_smoothmix}/*.safetensors
#MYANIFORM_LORA_FALLBACK=/Users/me/Models/Stable-Diffusion-LoRAs

# ── ComfyUI 워크플로우 디렉토리 (개발용) ──────────────────────────────
# 원본 워크플로우 디렉토리를 다른 곳에 두고 싶을 때. 미설정시 repo 의 workflows/originals 사용.
#MYANIFORM_COMFYUI_WORKFLOW_DIR=/Users/me/comfy-workflows
